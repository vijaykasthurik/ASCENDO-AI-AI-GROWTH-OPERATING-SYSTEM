# === LLM Providers ===
# Primary provider: custom OSM (OpenAI-compatible) endpoint
OSM_API_URL=https://api.osmapi.com/v1/chat/completions
OSM_API_KEY=
# gpt-4o (non-reasoning) responds in ~10-15s and is far cheaper than gpt-5
# (a reasoning model that burns thousands of hidden reasoning tokens, taking
# 2-3 min/call). Use gpt-5 only if you specifically need its reasoning depth.
OSM_MODEL=gpt-4o

# Fallback provider: Groq (OpenAI-compatible), tried in order if OSM fails
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES_PER_PROVIDER=2

# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ascendo

# === ChromaDB ===
CHROMA_PERSIST_DIR=./chroma_data

# === Auth ===
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === SMTP (transactional email) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ascendo AI
FRONTEND_BASE_URL=http://127.0.0.1:4173

# === Stripe (payments & subscriptions) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
